clear; clc; close all;

%% 1. Horizontal Error Plot
T = readtable("data.xlsx", 'Sheet', 'Hor_Error');
Hor_threshold = 0.1;
Ver_threshold = 0.2;
Pos_threshold = sqrt(Hor_threshold^2 + Ver_threshold^2);

figure; 
unique_networks = unique(T.Hor_Network);
num_networks = length(unique_networks);
t = tiledlayout('flow', 'TileSpacing', 'compact', 'Padding', 'compact');
title(t, 'Network별 Baseline에 따른 Horizontal Error', 'FontSize', 14);

min_baseline = min(T.Hor_Baseline);
max_baseline = max(T.Hor_Baseline);
padding = (max_baseline - min_baseline) * 0.05;
x_lims = [min_baseline - padding, max_baseline + padding];
y_lims_hor = [0, max(T.Hor_Error) * 1.1]; % Y축 범위 고정용

for i = 1:num_networks
    current_net_id = unique_networks(i);
    idx = (T.Hor_Network == current_net_id);
    current_baseline = T.Hor_Baseline(idx);
    current_error = T.Hor_Error(idx);
    
    ax = nexttile;
    
    % --- 임계값 기준으로 색상 분리 ---
    threshold = Hor_threshold;
    idx_above = (current_error > threshold);
    idx_below = (current_error <= threshold);
    
    % 임계값 이하 (파란색)
    stem(ax, current_baseline(idx_below), current_error(idx_below), 'filled', 'Color', 'b', 'MarkerFaceColor', 'b', 'MarkerSize', 4);
    hold(ax, 'on');
    
    % 임계값 초과 (빨간색)
    stem(ax, current_baseline(idx_above), current_error(idx_above), 'filled', 'Color', 'r', 'MarkerFaceColor', 'r', 'MarkerSize', 4);
    hold(ax, 'off');
    
    title(ax, sprintf('Network %d (n=%d)', current_net_id, length(current_error)));
    xlabel(ax, 'Hor Baseline');
    ylabel(ax, 'Hor Error [m]'); 
    grid on;
    xlim(ax, x_lims);
    ylim(ax, y_lims_hor); % Y축 범위 통일
    yline(ax, threshold, '--k', 'LineWidth', 1.5); % 검은색 점선
end

%% 2. Vertical Error Plot (절대값 적용 및 색상 분리)
T1 = readtable("data.xlsx",'Sheet','Ver_Error');

figure;
unique_networks = unique(T1.Ver_Network);
num_networks = length(unique_networks);
t = tiledlayout('flow', 'TileSpacing', 'compact', 'Padding', 'compact');
title(t, 'Network별 Baseline에 따른 Vertical Error (Absolute)', 'FontSize', 14);

min_baseline = min(T1.Ver_Baseline);
max_baseline = max(T1.Ver_Baseline);
padding = (max_baseline - min_baseline) * 0.05;
x_lims = [min_baseline - padding, max_baseline + padding];
% 절대값 기준으로 Y축 최대값 계산
y_lims_ver = [0, max(abs(T1.Ver_Error)) * 1.1];

for i = 1:num_networks
    current_net_id = unique_networks(i);
    idx = (T1.Ver_Network == current_net_id);
    current_baseline = T1.Ver_Baseline(idx);
    
    % --- [수정] Vertical Error는 절대값(abs)을 씌움 ---
    current_error = abs(T1.Ver_Error(idx));
    
    ax = nexttile;
    
    % --- [추가] 임계값 기준으로 색상 분리 ---
    threshold = Ver_threshold;
    idx_above = (current_error > threshold);
    idx_below = (current_error <= threshold);
    
    % 임계값 이하 (파란색)
    stem(ax, current_baseline(idx_below), current_error(idx_below), 'filled', 'Color', 'b', 'MarkerFaceColor', 'b', 'MarkerSize', 4);
    hold(ax, 'on');
    
    % 임계값 초과 (빨간색)
    stem(ax, current_baseline(idx_above), current_error(idx_above), 'filled', 'Color', 'r', 'MarkerFaceColor', 'r', 'MarkerSize', 4);
    hold(ax, 'off');
    % --- 수정 끝 ---
    
    title(ax, sprintf('Network %d (n=%d)', current_net_id, length(current_error)));
    xlabel(ax, 'Ver Baseline');
    ylabel(ax, 'Ver Error [m] (abs)'); % 절대값임을 표시
    grid on;
    xlim(ax, x_lims);
    ylim(ax, y_lims_ver); % Y축 범위 통일
    yline(ax, threshold, '--k', 'LineWidth', 1.5); % 검은색 점선
end

%% 3. Position Error Plot (색상 분리)
T2 = readtable("data.xlsx",'Sheet','Pos_Error');

figure;
unique_networks = unique(T2.Pos_Network);
num_networks = length(unique_networks);
t = tiledlayout('flow', 'TileSpacing', 'compact', 'Padding', 'compact');
title(t, 'Network별 Baseline에 따른 Position Error', 'FontSize', 14);

min_baseline = min(T2.Pos_Baseline);
max_baseline = max(T2.Pos_Baseline);
padding = (max_baseline - min_baseline) * 0.05;
x_lims = [min_baseline - padding, max_baseline + padding];
y_lims_pos = [0, max(T2.Pos_Error) * 1.1]; % Y축 범위 고정용

for i = 1:num_networks
    current_net_id = unique_networks(i);
    idx = (T2.Pos_Network == current_net_id);
    current_baseline = T2.Pos_Baseline(idx);
    current_error = T2.Pos_Error(idx);
    
    ax = nexttile;
    
    % --- [추가] 임계값 기준으로 색상 분리 ---
    threshold = Pos_threshold;
    idx_above = (current_error > threshold);
    idx_below = (current_error <= threshold);
    
    % 임계값 이하 (파란색)
    stem(ax, current_baseline(idx_below), current_error(idx_below), 'filled', 'Color', 'b', 'MarkerFaceColor', 'b', 'MarkerSize', 4);
    hold(ax, 'on');
    
    % 임계값 초과 (빨간색)
    stem(ax, current_baseline(idx_above), current_error(idx_above), 'filled', 'Color', 'r', 'MarkerFaceColor', 'r', 'MarkerSize', 4);
    hold(ax, 'off');
    % --- 수정 끝 ---

    title(ax, sprintf('Network %d (n=%d)', current_net_id, length(current_error)));
    xlabel(ax, 'Pos Baseline');
    ylabel(ax, 'Pos Error [m]');
    grid on;
    xlim(ax, x_lims);
    ylim(ax, y_lims_pos); % Y축 범위 통일
    yline(ax, threshold, '--k', 'LineWidth', 1.5); % 검은색 점선으로 수정
end
